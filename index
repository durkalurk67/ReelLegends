$('#soundBtn').addEventListener('click',()=>{S.sound=!S.sound;refreshHUD();save()});

const TABS=[['bag','Bag'],['gear','Gear'],['market','Market'],['quests','Quests'],['trade','Trade'],['hut','Hut'],['boat','Boat'],['boss','Bosses'],['skills','Skills'],['style','Style'],['dex','Fishdex']];
let curTab='quests',bagSort='value';
function tabBadge(id){if(id==='quests')return S.quests.some(q=>q&&q.done)||(STORY[S.story]&&STORY[S.story].c(S.storyBase));if(id==='skills')return S.sp>0;if(id==='hut')return S.hut.cash>=1&&S.hut.smoke>0;return false}
function renderTabs(){$('#tabs').innerHTML=TABS.map(([id,n])=>`<button class="tab" role="tab" data-tab="${id}" aria-selected="${curTab===id}">${n}${tabBadge(id)?'<span class="badge"></span>':''}</button>`).join('')}
$('#tabs').addEventListener('click',e=>{const b=e.target.closest('[data-tab]');if(!b)return;curTab=b.dataset.tab;renderTab();$('#tabBody').scrollTop=0});
const pips=(n,max)=>`<span class="pips">${Array.from({length:max},(_,i)=>`<i class="${i<n?'on':''}"></i>`).join('')}</span>`;
const costBtn=(action,cost,label,extra='',disabled=false)=>`<button class="btn ${S.coins>=cost?'':'ghost'}" data-a="${action}" ${extra} ${disabled?'disabled':''}>${label} ${cost?money(cost):''}</button>`;

function renderTab(){
  renderTabs();const R=RENDER[curTab];$('#tabBody').innerHTML=R?R():'';
}
const RENDER={
  bag(){
    const list=[...S.inv].sort((a,b)=>bagSort==='value'?fishValue(b)-fishValue(a):bagSort==='rarity'?RAR.indexOf(FISHM[b.id].r)-RAR.indexOf(FISHM[a.id].r):b.w-a.w);
    const total=S.inv.filter(i=>!i.fav).reduce((t,i)=>t+fishValue(i),0);
    return `<h2>Your bag</h2><p class="sub">${S.inv.length} of ${bagMax()} slots used. Star a fish to protect it from bulk selling and trades.</p>
    <div class="toolbar"><button class="btn red" data-a="sellAll" ${total?'':'disabled'}>Sell all unstarred ${money(total)}</button>
    ${['value','rarity','weight'].map(k=>`<button class="btn ${bagSort===k?'':'ghost'}" data-a="sort" data-x="${k}">By ${k}</button>`).join('')}</div>
    ${list.length?`<div class="grid">${list.map(it=>{const f=FISHM[it.id];return `<div class="card">
      <button class="star ${it.fav?'on':''}" data-a="fav" data-u="${it.uid}" aria-label="${it.fav?'Unstar':'Star'} ${f.name}">${it.fav?'★':'☆'}</button>
      ${fishSVG(f,it.v,82)}<div class="fn rar-${f.r}">${f.name}</div><div class="fm">${it.w} lb${it.v==='s'?' · Shiny':it.v==='h'?' · Holo':''}</div>
      <div class="acts"><button class="btn" data-a="sell" data-u="${it.uid}">Sell ${money(fishValue(it))}</button>${S.hut.aqua*2>S.aqua.length?`<button class="btn ghost" data-a="display" data-u="${it.uid}">Display</button>`:''}</div></div>`}).join('')}</div>`
    :'<p class="sub">Empty for now. Tap the red bobber to cast and fill it.</p>'}`;
  },
  gear(){
    const st=stats(),rc=rodCombo(),bc=baitCombo();
    return `<h2>Gear</h2><div class="statgrid">
      <div class="stat"><b>${st.luck.toFixed(2)}</b><span>Luck</span></div><div class="stat"><b>×${(1+st.shiny).toFixed(2)}</b><span>Shiny odds</span></div>
      <div class="stat"><b>${Math.round((1-st.bite)*100)}%</b><span>Faster bites</span></div><div class="stat"><b>${st.power}</b><span>Rod power</span></div>
      <div class="stat"><b>${Math.round(st.zone*100)}%</b><span>Reel zone</span></div><div class="stat"><b>${st.lineMax}</b><span>Line max (lb)</span></div></div>
      <h3>Rods</h3>${RODS.map(r=>{const own=S.rods.includes(r.id);return `<div class="row"><div class="grow"><div class="name">${r.name}${S.rod===r.id?'<span class="tag">Equipped</span>':''}</div><div class="meta">Power ${r.power} · Luck +${r.luck}${!own&&S.level<r.lvl?` · Needs level ${r.lvl}`:''}</div></div>
        ${own?(S.rod===r.id?'':`<button class="btn ghost" data-a="eqRod" data-x="${r.id}">Equip</button>`):costBtn('buyRod',r.price,'Buy',`data-x="${r.id}"`,S.level<r.lvl)}</div>`}).join('')}
      <h3>Lines</h3>${LINES.map(l=>{const own=S.lines.includes(l.id);return `<div class="row"><div class="grow"><div class="name">${l.name}${S.line===l.id?'<span class="tag">Equipped</span>':''}</div><div class="meta">Holds fish up to ${l.max} lb${!own&&S.level<l.lvl?` · Needs level ${l.lvl}`:''}</div></div>
        ${own?(S.line===l.id?'':`<button class="btn ghost" data-a="eqLine" data-x="${l.id}">Equip</button>`):costBtn('buyLine',l.price,'Buy',`data-x="${l.id}"`,S.level<l.lvl)}</div>`}).join('')}
      <h3>Bait</h3>${BAITS.filter(b=>(S.bait[b.id]||0)>0||S.baitSel===b.id).map(b=>`<div class="row"><span class="bigemoji">${b.icon}</span><div class="grow"><div class="name">${b.name}${S.baitSel===b.id?'<span class="tag">On hook</span>':''}</div><div class="meta">${S.bait[b.id]||0} left · Draws ${FISH.filter(f=>f.baits.includes(b.id)&&!f.req).map(f=>AREA[f.area].name).filter((v,i,a)=>a.indexOf(v)===i).join(', ')||'special fish'}</div></div>${S.baitSel===b.id?'':`<button class="btn ghost" data-a="eqBait" data-x="${b.id}">Use</button>`}</div>`).join('')||'<p class="sub">No bait. Buy some in Market.</p>'}
      <h3>Attractant</h3><div class="row"><div class="grow"><div class="name">None${!S.attrSel?'<span class="tag">Active</span>':''}</div></div>${S.attrSel?'<button class="btn ghost" data-a="eqAttr" data-x="">Use none</button>':''}</div>
      ${ATTRS.filter(a=>(S.attrs[a.id]||0)>0).map(a=>`<div class="row"><span class="bigemoji">${a.icon}</span><div class="grow"><div class="name">${a.name}${S.attrSel===a.id?'<span class="tag">Active</span>':''}</div><div class="meta">${S.attrs[a.id]} left · ${a.desc}</div></div>${S.attrSel===a.id?'':`<button class="btn ghost" data-a="eqAttr" data-x="${a.id}">Use</button>`}</div>`).join('')}
      <h3>Combo journal</h3><p class="sub">Certain rod and line pairs, and certain bait and attractant pairs, unlock bonuses and secret fish.</p>
      ${ROD_COMBOS.map(c=>S.combosFound[c.id]?`<div class="row"><div class="grow"><div class="name">${c.name}${rc&&rc.id===c.id?'<span class="tag">Active</span>':''}</div><div class="meta">${RODM[c.rod].name} + ${LINEM[c.line].name}: ${c.desc}</div></div></div>`:`<div class="row"><div class="grow"><div class="name">Unknown rod combo</div><div class="meta">Hint: ${c.hint}</div></div></div>`).join('')}
      ${BAIT_COMBOS.map(c=>S.combosFound[c.id]?`<div class="row"><div class="grow"><div class="name">${c.name}${bc&&bc.id===c.id?'<span class="tag">Active</span>':''}</div><div class="meta">${BAITM[c.bait].name} + ${ATTRM[c.attr].name}: ${c.desc}</div></div></div>`:`<div class="row"><div class="grow"><div class="name">Unknown bait combo</div><div class="meta">Hint: ${c.hint}</div></div></div>`).join('')}`;
  },
  market(){
    const total=S.inv.filter(i=>!i.fav).reduce((t,i)=>t+fishValue(i),0);
    return `<h2>Market</h2><p class="sub">Sell your catch and stock up on bait. Prices rise with size, and shiny fish sell for 4×, holo for 15×.</p>
      <div class="toolbar"><button class="btn red" data-a="sellAll" ${total?'':'disabled'}>Sell all unstarred ${money(total)}</button><button class="btn ghost" data-a="sellCommon">Sell commons only</button></div>
      <h3>Bait (packs of 10)</h3>${BAITS.map(b=>`<div class="row"><span class="bigemoji">${b.icon}</span><div class="grow"><div class="name">${b.name}</div><div class="meta">You have ${S.bait[b.id]||0}${S.level<b.lvl?` · Needs level ${b.lvl}`:''}</div></div>${costBtn('buyBait',b.price,'Buy',`data-x="${b.id}"`,S.level<b.lvl)}</div>`).join('')}
      <h3>Attractants (packs of 5)</h3><p class="sub">Mixed into your bait. One is used each time you hook a fish.</p>${ATTRS.map(a=>`<div class="row"><span class="bigemoji">${a.icon}</span><div class="grow"><div class="name">${a.name}</div><div class="meta">${a.desc} · You have ${S.attrs[a.id]||0}${S.level<a.lvl?` · Needs level ${a.lvl}`:''}</div></div>${costBtn('buyAttr',a.price,'Buy',`data-x="${a.id}"`,S.level<a.lvl)}</div>`).join('')}`;
  },
  quests(){
    const sq=STORY[S.story];const sqDone=sq&&sq.c(S.storyBase);const rw=storyReward(S.story);
    return `<h2>Quests</h2>
      <h3>Main story</h3>${sq?`<div class="row"><div class="grow"><div class="name">${sq.t}</div><div class="meta">${sq.p?sq.p(S.storyBase)+' · ':''}Reward ${money(rw.coins)} and ${rw.xp} XP · Chapter ${S.story+1} of ${STORY.length}</div></div>${sqDone?'<button class="btn gold" data-a="claimStory">Claim</button>':''}</div>`:'<p class="sub">You finished the story. You are a Reel Legend.</p>'}
      <h3>Job board</h3><p class="sub">New jobs post 5 minutes after you finish one.</p>
      ${[0,1,2].map(i=>{const q=S.quests[i];if(!q)return `<div class="row"><div class="grow"><div class="name">New job posting in <span data-cd="${S.qSlots[i]}">${mmss(S.qSlots[i]-now())}</span></div></div></div>`;
        return `<div class="row"><div class="grow"><div class="name">${esc(q.text)}</div><div class="meta">${q.type==='sell'?money(Math.min(q.prog,q.n))+' / '+money(q.n):Math.min(q.prog,q.n)+'/'+q.n} · Reward ${money(q.reward.coins)} and ${q.reward.xp} XP</div></div>
        ${q.done?`<button class="btn gold" data-a="claimQ" data-x="${i}">Claim</button>`:costBtn('rerollQ',25+S.level*10,'Swap',`data-x="${i}"`)}</div>`}).join('')}`;
  },
  trade(){
    refreshTrades();
    return `<h2>Trading post</h2><p class="sub">Old Marlo the merchant swaps goods for fish. New offers in <span data-cd="${S.tradeAt}">${mmss(S.tradeAt-now())}</span>. Starred fish are never traded.</p>
      ${S.trades.map((o,i)=>{if(!o)return `<div class="row"><div class="grow"><div class="name">Marlo is restocking this shelf.</div></div></div>`;const m=tradeMatches(o.give);const ok=m.length>=o.give.n;
        return `<div class="row"><div class="grow"><div class="name">${giveText(o.give)}</div><div class="meta">For ${getText(o.get)} · You have ${m.length}/${o.give.n}</div></div><button class="btn ${ok?'gold':'ghost'}" data-a="doTrade" data-x="${i}" ${ok?'':'disabled'}>Trade</button></div>`}).join('')}
      <div class="toolbar" style="margin-top:12px">${costBtn('refreshTrades',100+S.level*20,'Restock now')}</div>`;
  },
  hut(){
    const h=S.hut;
    if(!h.lvl)return `<h2>Fishing hut</h2><p class="sub">A hut on stilts over Willow Pond. It unlocks a smokehouse that earns coins while you are away, a bait farm, extra storage and an aquarium.</p>${costBtn('upHut',HUTS[1].price,'Build a Shack','',S.level<HUTS[1].lvl)}${S.level<HUTS[1].lvl?`<p class="sub">Needs level ${HUTS[1].lvl}.</p>`:''}`;
    const nx=HUTS[h.lvl+1];
    return `<h2>${HUTS[h.lvl].name}</h2><p class="sub">Your hut sits over Willow Pond. Facilities can be upgraded up to level ${Math.min(5,h.lvl+1)} at this hut size.</p>
      ${nx?`<div class="row"><div class="grow"><div class="name">Upgrade to ${nx.name}</div><div class="meta">Raises facility caps${S.level<nx.lvl?` · Needs level ${nx.lvl}`:''}</div></div>${costBtn('upHut',nx.price,'Upgrade','',S.level<nx.lvl)}</div>`:''}
      ${h.smoke?`<div class="row"><div class="grow"><div class="name">Smokehouse earnings: <span id="hutCash">${money(h.cash)}</span></div><div class="meta">Stores up to 4 hours of earnings</div></div><button class="btn gold" data-a="collect" ${h.cash>=1?'':'disabled'}>Collect</button></div>`:''}
      <h3>Facilities</h3>${FACILITIES.map(f=>{const n=h[f.id],max=Math.min(5,h.lvl+1),cost=f.base*Math.pow(n+1,2);return `<div class="row"><div class="grow"><div class="name">${f.name} ${pips(n,5)}</div><div class="meta">${f.desc(n)}</div></div>${n<max?costBtn('upFac',cost,'Upgrade',`data-x="${f.id}"`):`<span class="meta">${n>=5?'Maxed':'Upgrade hut'}</span>`}</div>`}).join('')}
      ${h.aqua?`<h3>Aquarium</h3><p class="sub">${S.aqua.length}/${h.aqua*2} tanks filled. Bonus luck +${aquaLuck().toFixed(2)}. Display fish from your bag.</p><div class="grid">${S.aqua.map(it=>{const f=FISHM[it.id];return `<div class="card">${fishSVG(f,it.v,80)}<div class="fn rar-${f.r}">${f.name}</div><div class="fm">${it.w} lb</div><div class="acts"><button class="btn ghost" data-a="undisplay" data-u="${it.uid}">Take back</button></div></div>`}).join('')}</div>`:''}`;
  },
  boat(){
    const b=S.boat,nx=BOATS[b.tier+1],up=[['hull','Hull','Absorbs 6% boss damage per level and adds HP'],['harpoon','Harpoon','+14 damage per boss strike'],['hold','Cargo hold','+10 bag space']];
    return `<h2>${b.tier?BOATS[b.tier].name:'Boat dock'}</h2><p class="sub">Boats reach new waters: Rowboat for the Coral Reef, Motorboat for the Frozen Fjord, Iron Trawler for Ember Lagoon, and the Bathysphere for the Abyssal Trench.</p>
      ${nx?`<div class="row"><div class="grow"><div class="name">${nx.name}</div><div class="meta">Opens ${AREAS.find(a=>a.boat===nx.tier).name}${S.level<nx.lvl?` · Needs level ${nx.lvl}`:''}</div></div>${costBtn('buyBoat',nx.price,b.tier?'Upgrade':'Buy','',S.level<nx.lvl)}</div>`:'<p class="sub">You own the finest vessel on the water.</p>'}
      ${b.tier?`<h3>Upgrades</h3>${up.map(([k,n,d])=>{const lv=b[k],cost=350*Math.pow(lv+1,2);return `<div class="row"><div class="grow"><div class="name">${n} ${pips(lv,5)}</div><div class="meta">${d}</div></div>${lv<5?costBtn('upBoat',cost,'Upgrade',`data-x="${k}"`):'<span class="meta">Maxed</span>'}</div>`}).join('')}`:''}`;
  },
  boss(){
    return `<h2>Sea monsters</h2><p class="sub">Strike when the needle hits green for a critical blow that also patches your boat. Your rod power, harpoon, hull, Strength and level all matter.</p>
      ${BOSSES.map(bo=>{const a=AREA[bo.area],open=areaOpen(a)&&S.level>=bo.lvl,beat=S.boss[bo.id];const drop=bo.drop.pet?`${PETS[bo.drop.pet].emoji} ${PETS[bo.drop.pet].name} pet`:`🎩 ${HATS[bo.drop.hat].name}`;
        return `<div class="row"><span class="bigemoji">${bo.emoji}</span><div class="grow"><div class="name">${bo.name}, ${bo.title}${beat?`<span class="tag">Defeated ×${beat}</span>`:''}</div><div class="meta">${a.name} · ${fmt(bo.hp)} HP · ${beat?`Rematch pays ${money(bo.coins*.3)}`:`Reward ${money(bo.coins)} and ${drop}`}${open?'':` · Needs level ${bo.lvl} and access to ${a.name}`}</div></div><button class="btn red" data-a="fight" data-x="${bo.id}" ${open?'':'disabled'}>Fight</button></div>`}).join('')}`;
  },
  skills(){
    return `<h2>Skills</h2><p class="sub">You earn one point each level. ${S.sp?`<b>${S.sp} to spend.</b>`:''}</p>
      ${SKILLS.map(k=>`<div class="row"><div class="grow"><div class="name">${k.name} ${pips(S.skills[k.id],10)}</div><div class="meta">${k.desc}</div></div><button class="btn" data-a="skill" data-x="${k.id}" ${S.sp&&S.skills[k.id]<10?'':'disabled'}>+1</button></div>`).join('')}
      <h3>Records</h3><div class="statgrid"><div class="stat"><b>${fmt(S.stats.caught)}</b><span>Fish caught</span></div><div class="stat"><b>${fmt(S.stats.shinies)}</b><span>Shiny or holo</span></div><div class="stat"><b>${money(S.stats.sold)}</b><span>Earned selling</span></div></div>
      <h3>Save</h3><div class="toolbar"><button class="btn ghost" data-a="export">Copy save code</button><button class="btn ghost" data-a="import">Load save code</button><button class="btn ghost" data-a="reset">Start over</button></div>`;
  },
  style(){
    return `<h2>Style</h2><h3>Hats</h3>${Object.entries(HATS).map(([id,h])=>{const own=S.cos.hats.includes(id);return `<div class="row"><div class="grow"><div class="name">${h.name}${S.cos.hat===id?'<span class="tag">Wearing</span>':''}</div>${!own&&h.only?`<div class="meta">${h.only}</div>`:''}</div>${own?(S.cos.hat===id?'':`<button class="btn ghost" data-a="wearHat" data-x="${id}">Wear</button>`):h.only?'<span class="meta">🔒</span>':costBtn('buyHat',h.price,'Buy',`data-x="${id}"`)}</div>`}).join('')}
      <h3>Outfit</h3><div class="swatches">${OUTFITS.map(o=>`<button class="swatch" aria-label="${o.id} outfit${S.cos.outfits.includes(o.id)?'':' for '+money(o.price)}" aria-pressed="${S.cos.outfit===o.id}" data-a="outfit" data-x="${o.id}" style="background:${o.c==='holo'?'conic-gradient(#ff6ad5,#94d0ff,#8affc1,#fff58a,#ff6ad5)':o.c};${S.cos.outfits.includes(o.id)?'':'opacity:.45'}" title="${S.cos.outfits.includes(o.id)?'Owned':money(o.price)}"></button>`).join('')}</div><p class="sub" style="margin-top:6px">Faded colors are for sale. Tap to buy.</p>
      <h3>Skin tone</h3><div class="swatches">${SKINS.map(c=>`<button class="swatch" aria-label="Skin tone" aria-pressed="${S.cos.skin===c}" data-a="skin" data-x="${c}" style="background:${c}"></button>`).join('')}</div>
      <h3>Pets</h3><p class="sub">Your pet follows you around and gives a bonus.</p>${Object.entries(PETS).map(([id,p])=>{const own=S.pets.includes(id);return `<div class="row"><span class="bigemoji">${p.emoji}</span><div class="grow"><div class="name">${p.name}${S.pet===id?'<span class="tag">With you</span>':''}</div><div class="meta">${p.desc}${!own&&p.only?' · '+p.only:''}</div></div>${own?(S.pet===id?'<button class="btn ghost" data-a="pet" data-x="">Send home</button>':`<button class="btn ghost" data-a="pet" data-x="${id}">Bring along</button>`):p.only?'<span class="meta">🔒</span>':costBtn('buyPet',p.price,'Adopt',`data-x="${id}"`)}</div>`}).join('')}`;
  },
  dex(){
    const caught=FISH.filter(f=>S.dex[f.id]).length;
    return `<h2>Fishdex</h2><p class="sub">${caught} of ${FISH.length} species found.</p>${AREAS.map(a=>`<h3>${a.name}</h3><div class="grid">${FISH.filter(f=>f.area===a.id).map(f=>{const d=S.dex[f.id];
      if(d)return `<div class="card">${fishSVG(f,d.h?'h':d.s?'s':'n',80)}<div class="fn rar-${f.r}">${f.name}</div><div class="fm">×${d.n} · best ${d.max} lb${d.s?` · ${d.s} shiny`:''}${d.h?` · ${d.h} holo`:''}</div><div class="fm">Bait: ${f.baits.map(b=>BAITM[b].icon).join(' ')}</div></div>`;
      return `<div class="card sil">${fishSVG(f,'n',80,true)}<div class="fn rar-${f.r}">???</div><div class="fm">${RARD[f.r].n} · Bait: ${f.baits.map(b=>BAITM[b].icon).join(' ')}</div>${f.req?`<div class="fm">${f.req.combo?'Needs a secret rod combo':`Needs ${ATTRM[f.req.attr].name}`}</div>`:''}</div>`}).join('')}</div>`).join('')}`;
  }
};

/* ============ actions ============ */
function findInv(u){return S.inv.find(i=>i.uid===u)}
function sellItems(items){if(!items.length)return;const total=items.reduce((t,i)=>t+fishValue(i),0);const ids=new Set(items.map(i=>i.uid));S.inv=S.inv.filter(i=>!ids.has(i.uid));addCoins(total);S.stats.sold+=total;questOnSell(total);sfx.coin();toast(`💰 Sold ${items.length} fish for ${money(total)}.`)}
const ACT={
  sort:x=>{bagSort=x},
  fav:(x,u)=>{const it=findInv(u);if(it)it.fav=!it.fav},
  sell:(x,u)=>{const it=findInv(u);if(it)sellItems([it])},
  sellAll:()=>sellItems(S.inv.filter(i=>!i.fav)),
  sellCommon:()=>sellItems(S.inv.filter(i=>!i.fav&&FISHM[i.id].r==='common'&&i.v==='n')),
  display:(x,u)=>{const it=findInv(u);if(!it||S.aqua.length>=S.hut.aqua*2)return;S.inv=S.inv.filter(i=>i!==it);S.aqua.push(it);toast(`🐠 ${FISHM[it.id].name} is now on display.`)},
  undisplay:(x,u)=>{if(S.inv.length>=bagMax()){toast('Bag is full.','red');return}const it=S.aqua.find(i=>i.uid===u);if(!it)return;S.aqua=S.aqua.filter(i=>i!==it);S.inv.push(it)},
  eqRod:x=>{S.rod=x},eqLine:x=>{S.line=x},eqBait:x=>{S.baitSel=x},eqAttr:x=>{S.attrSel=x||null},
  buyRod:x=>{const r=RODM[x];if(spend(r.price)){S.rods.push(x);S.rod=x;toast(`🎣 ${r.name} equipped.`)}},
  buyLine:x=>{const l=LINEM[x];if(spend(l.price)){S.lines.push(x);S.line=x;toast(`🧵 ${l.name} equipped.`)}},
  buyBait:x=>{if(spend(BAITM[x].price))S.bait[x]=(S.bait[x]||0)+10},
  buyAttr:x=>{if(spend(ATTRM[x].price)){S.attrs[x]=(S.attrs[x]||0)+5;if(!S.attrSel)S.attrSel=x}},
  claimStory:()=>{const sq=STORY[S.story];if(!sq||!sq.c(S.storyBase))return;const r=storyReward(S.story);addCoins(r.coins);addXP(r.xp);sfx.catch();toast(`📖 Chapter complete! +${money(r.coins)}`,'gold');S.story++;S.storyBase=snapStats()},
  claimQ:x=>{const q=S.quests[x];if(!q||!q.done)return;addCoins(q.reward.coins);addXP(q.reward.xp);sfx.coin();toast(`📜 +${money(q.reward.coins)} and ${q.reward.xp} XP`,'gold');S.quests[x]=null;S.qSlots[x]=now()+5*60*1000},
  rerollQ:x=>{if(spend(25+S.level*10))S.quests[x]=genQuest()},
  doTrade:x=>{const o=S.trades[x];if(!o)return;const m=tradeMatches(o.give);if(m.length<o.give.n)return;const ids=new Set(m.map(i=>i.uid));S.inv=S.inv.filter(i=>!ids.has(i.uid));
    const g=o.get;if(g.kind==='coins')addCoins(g.n);if(g.kind==='bait')S.bait[g.id]=(S.bait[g.id]||0)+g.n;if(g.kind==='attr')S.attrs[g.id]=(S.attrs[g.id]||0)+g.n;if(g.kind==='hat'&&!S.cos.hats.includes(g.id))S.cos.hats.push(g.id);
    S.trades[x]=null;sfx.coin();toast(`🤝 Traded for ${getText(g)}.`,'gold')},
  refreshTrades:()=>{if(spend(100+S.level*20))refreshTrades(true)},
  upHut:()=>{const nx=HUTS[S.hut.lvl+1];if(nx&&S.level>=nx.lvl&&spend(nx.price)){S.hut.lvl++;toast(`🏠 Your ${nx.name} is ready at Willow Pond.`,'gold')}},
  upFac:x=>{const f=FACILITIES.find(f=>f.id===x),n=S.hut[x];if(n>=Math.min(5,S.hut.lvl+1))return;if(spend(f.base*Math.pow(n+1,2)))S.hut[x]++},
  collect:()=>{const c=Math.floor(S.hut.cash);if(c<1)return;addCoins(c);S.hut.cash-=c;sfx.coin();toast(`🔥 Collected ${money(c)} from the smokehouse.`)},
  buyBoat:()=>{const nx=BOATS[S.boat.tier+1];if(nx&&S.level>=nx.lvl&&spend(nx.price)){S.boat.tier++;toast(`⛵ ${nx.name} is ready. ${AREAS.find(a=>a.boat===nx.tier).name} is reachable.`,'gold')}},
  upBoat:x=>{const lv=S.boat[x];if(lv<5&&spend(350*Math.pow(lv+1,2)))S.boat[x]++},
  fight:x=>startBoss(x),
  skill:x=>{if(S.sp>0&&S.skills[x]<10){S.sp--;S.skills[x]++}},
  buyHat:x=>{if(spend(HATS[x].price)){S.cos.hats.push(x);S.cos.hat=x}},
  wearHat:x=>{S.cos.hat=x},
  outfit:x=>{if(S.cos.outfits.includes(x)){S.cos.outfit=x;return}const o=OUTFITS.find(o=>o.id===x);if(spend(o.price)){S.cos.outfits.push(x);S.cos.outfit=x}},
  skin:x=>{S.cos.skin=x},
  buyPet:x=>{if(spend(PETS[x].price)){S.pets.push(x);S.pet=x;toast(`${PETS[x].emoji} ${PETS[x].name} joined you!`,'gold')}},
  pet:x=>{S.pet=x||null;P.petX=P.x-30},
  export:()=>{const code=btoa(unescape(encodeURIComponent(JSON.stringify(S))));(navigator.clipboard?navigator.clipboard.writeText(code):Promise.reject()).then(()=>toast('Save code copied.')).catch(()=>openModal(`<h2>Your save code</h2><p class="sub">Copy this and keep it somewhere safe.</p><textarea style="width:100%;height:140px" readonly>${code}</textarea><div class="acts"><button class="btn" data-m="close">Done</button></div>`))},
  import:()=>openModal(`<h2>Load a save code</h2><p class="sub">This replaces your current progress.</p><textarea id="impBox" style="width:100%;height:140px"></textarea><div class="acts"><button class="btn red" data-m="doImport">Load</button><button class="btn ghost" data-m="close">Cancel</button></div>`),
  reset:()=>openModal(`<h2>Start over?</h2><p class="sub">This erases all fish, coins, gear and progress on this device.</p><div class="acts"><button class="btn red" data-m="doReset">Erase and restart</button><button class="btn ghost" data-m="close">Keep playing</button></div>`)
};
$('#tabBody').addEventListener('click',e=>{const b=e.target.closest('[data-a]');if(!b||b.disabled)return;const f=ACT[b.dataset.a];if(!f)return;f(b.dataset.x,b.dataset.u);refreshAll();save()});

$('#modal').addEventListener('click',e=>{
  if(e.target.id==='modal'&&!bossState){closeModal();return}
  const b=e.target.closest('[data-m]');if(!b)return;const m=b.dataset.m;
  if(m==='keep'||m==='close')closeModal();
  if(m==='sell'){const it=findInv(b.dataset.u);if(it)sellItems([it]);closeModal();refreshAll();save()}
  if(m==='doReset'){try{localStorage.removeItem(SAVE_KEY)}catch(err){}S=fresh();S.storyBase=snapStats();fillQuests();closeModal();FS.state='idle';refreshCast();refreshAll();save()}
  if(m==='doImport'){try{const d=JSON.parse(decodeURIComponent(escape(atob($('#impBox').value.trim()))));if(d.v!==1)throw 0;S=Object.assign(fresh(),d);closeModal();refreshAll();save();toast('Save loaded.')}catch(err){toast('That save code could not be read. Check that it was copied in full.','red')}}
  if(m==='strike')bossStrike();
  if(m==='flee'){endBoss(false,true)}
  if(m==='bossDone')closeModal();
});

/* ============ boss fights ============ */
let bossState=null;
function startBoss(id){
  if(FS.state==='reel')return;FS.state='idle';refreshCast();
  const bo=BOSSM[id],st=stats(),maxHP=150+S.boat.hull*80+S.level*10;
  bossState={bo,hp:bo.hp,me:maxHP,meMax:maxHP,needle:0,dir:1,cd:0,atkT:bo.every,lock:0,dmg:10+S.boat.harpoon*14+st.power*7+S.skills.str*2+S.level,red:1-S.boat.hull*.06,raf:0,lastT:performance.now()};
  openModal(`<div class="boss"><div class="lbl"><span>${bo.name}</span><span id="bHp"></span></div><div class="bar hp"><i id="bHpBar" style="width:100%"></i></div>
    <div class="face" id="bFace">${bo.emoji}</div><div class="blog" id="bLog">${bo.name} rises from the water!</div>
    <div class="meter"><div class="y"></div><div class="g"></div><div class="needle" id="bNeedle"></div></div>
    <div class="lbl"><span>Your boat</span><span id="bMe"></span></div><div class="bar me"><i id="bMeBar" style="width:100%"></i></div>
    <div class="acts"><button class="btn red" data-m="strike" style="font-size:18px;padding:12px 28px">Strike</button><button class="btn ghost" data-m="flee">Retreat</button></div>
    <p class="sub" style="margin-top:8px">Press Space or tap Strike. Green is a critical hit.</p></div>`,()=>{if(bossState){cancelAnimationFrame(bossState.raf);bossState=null}});
  bossState.raf=requestAnimationFrame(bossLoop);bossUI();
}
function bossUI(){const b=bossState;if(!b)return;$('#bHp').textContent=`${fmt(Math.max(0,b.hp))} / ${fmt(b.bo.hp)}`;$('#bHpBar').style.width=Math.max(0,b.hp/b.bo.hp*100)+'%';$('#bMe').textContent=`${fmt(Math.max(0,b.me))} / ${fmt(b.meMax)}`;$('#bMeBar').style.width=Math.max(0,b.me/b.meMax*100)+'%'}
function bossLoop(t){
  const b=bossState;if(!b)return;const dt=Math.min(.05,(t-b.lastT)/1000);b.lastT=t;
  b.needle+=b.dir*dt*b.bo.spd*1.1;if(b.needle>1){b.needle=1;b.dir=-1}if(b.needle<0){b.needle=0;b.dir=1}
  const nd=$('#bNeedle');if(nd)nd.style.left=(b.needle*100)+'%';
  b.cd-=dt;b.lock-=dt;b.atkT-=dt;
  if(b.atkT<=0){const enr=b.hp<b.bo.hp*.3;b.atkT=b.bo.every*(enr?.75:1);const d=Math.round(b.bo.atk*rnd(.8,1.2)*b.red);b.me-=d;sfx.hit();const l=$('#bLog');if(l)l.textContent=`${b.bo.name} ${pick(['slams','bites','lashes','crushes'])} your boat for ${d}!${enr?' It is enraged!':''}`;bossUI();
    if(b.me<=0){endBoss(false);return}}
  b.raf=requestAnimationFrame(bossLoop);
}
function bossStrike(){
  const b=bossState;if(!b||b.cd>0||b.lock>0)return;b.cd=.45;
  const d=Math.abs(b.needle-.5);let mult=0,msg;
  if(d<=.06){mult=2.2;msg='Critical strike!';b.me=Math.min(b.meMax,b.me+b.meMax*.04)}else if(d<=.15){mult=1;msg='Solid hit.'}else{b.lock=.9;msg='Missed! Steady your aim.'}
  const dmg=Math.round(b.dmg*mult*rnd(.9,1.1));b.hp-=dmg;
  const l=$('#bLog');if(l)l.textContent=mult?`${msg} ${dmg} damage.`:msg;
  if(mult){sfx.hit();const f=$('#bFace');if(f){f.classList.add('hit');setTimeout(()=>f.classList.remove('hit'),120)}}
  bossUI();if(b.hp<=0)endBoss(true);
}
function endBoss(won,fled){
  const b=bossState;if(!b)return;cancelAnimationFrame(b.raf);bossState=null;const bo=b.bo;
  let html;
  if(won){const first=!S.boss[bo.id];S.boss[bo.id]=(S.boss[bo.id]||0)+1;const c=first?bo.coins:Math.round(bo.coins*.3);addCoins(c);addXP(first?bo.xp:bo.xp*.3);
    let drop='';if(first){if(bo.drop.pet&&!S.pets.includes(bo.drop.pet)){S.pets.push(bo.drop.pet);drop=`${PETS[bo.drop.pet].emoji} ${PETS[bo.drop.pet].name} wants to join you. Find them in Style.`}if(bo.drop.hat&&!S.cos.hats.includes(bo.drop.hat)){S.cos.hats.push(bo.drop.hat);drop=`🎩 You claimed the ${HATS[bo.drop.hat].name}. Wear it from Style.`}}
    sfx.lvl();html=`<div class="boss"><div class="face">🏆</div><h2>${bo.name} defeated!</h2><p class="sub">+${money(c)}${drop?'<br>'+drop:''}</p><div class="acts"><button class="btn gold" data-m="bossDone">Celebrate</button></div></div>`}
  else html=`<div class="boss"><div class="face">${bo.emoji}</div><h2>${fled?'You retreated':'Your boat was battered'}</h2><p class="sub">${fled?'Live to fish another day.':`Upgrade your hull and harpoon in Boat, raise Strength, or bring a stronger rod, then try again.`}</p><div class="acts"><button class="btn" data-m="bossDone">Back to fishing</button></div></div>`;
  $('#modalCard').innerHTML=html;modalOnClose=null;refreshAll();save();
}
window.addEventListener('keydown',e=>{if(bossState&&e.code==='Space'){e.preventDefault();bossStrike()}});

/* ============ boot ============ */
(function boot(){
  const away=Math.min(8*60,(now()-(S.lastSeen||now()))/60000);
  if(away>1&&S.hut.lvl>0){let msg=[];if(S.hut.smoke){const rate=SMOKE[S.hut.smoke];const add=Math.min(rate*240-S.hut.cash,rate*away);if(add>0){S.hut.cash+=add;msg.push(`${money(add)} in the smokehouse`)}}
    if(S.hut.farm){const n=Math.floor(S.hut.farm*away);if(n){S.bait.worm=(S.bait.worm||0)+n;msg.push(`${n} worms from the bait farm`)}}
    if(msg.length)setTimeout(()=>toast(`🏠 While you were away: ${msg.join(' and ')}.`,'gold'),600)}
  if(!areaOpen(AREA[S.area]))S.area='pond';
  fillQuests();refreshTrades();resize();refreshCast();refreshAll();save();
  requestAnimationFrame(t=>{last=t;loop(t)});
  if(S.stats.caught===0)setTimeout(()=>toast('🎣 Tap the red bobber to cast. When you see “!”, tap again to hook.'),500);
})();
</script>
</body>
