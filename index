  FS.mg={zone:st.zone,zy:.3,v:0,fishY:.5,target:.5,tt:0,prog:.28,grace:.7,diff,heavy,spd:(1.3+diff*1.7)*(heavy?1.3:1),decay:(.8+diff*.3)*(heavy?1.6:1)};
