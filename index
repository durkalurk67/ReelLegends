  const maxRi=Math.min(3,Math.floor(S.level/5)+1);let o={id:uid()};
  if(t==='rarity'){const ri=rint(0,maxRi);o.give={kind:'rarity',ri,n:[5,4,2,1][ri]};}
  else if(t==='species'){const pool=FISH.filter(f=>areas.some(a=>a.id===f.area)&&RAR.indexOf(f.r)<=1&&!f.req);const f=pick(pool);o.give={kind:'species',id:f.id,n:rint(2,4)}}
  else o.give={kind:'shiny',n:1};
  const est=(o.give.kind==='shiny'?120:o.give.kind==='species'?FISHM[o.give.id].price*o.give.n:[12,30,90,260][o.give.ri]*o.give.n*(1+areas.length*.3));
  const r=Math.random();
  const baitOk=BAITS.filter(b=>b.lvl<=S.level+3).slice(-3),attrOk=ATTRS.filter(a=>a.lvl<=S.level+2);
  if(o.give.kind==='shiny')o.get=r<.5?{kind:'attr',id:'glitter',n:5}:{kind:'coins',n:Math.round(est*3)};
  else if(r<.12&&!S.cos.hats.includes('fez'))o.get={kind:'hat',id:'fez'};
  else if(r<.4)o.get={kind:'attr',id:pick(attrOk).id,n:rint(3,6)};
  else if(r<.7){const b=pick(baitOk);o.get={kind:'bait',id:b.id,n:Math.max(10,Math.round(est*2.2/(b.price/10)/5)*5)}}
  else o.get={kind:'coins',n:Math.round(est*1.8)};
  return o;
}
