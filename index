/* ============ main loop ============ */
let last=performance.now(),secAcc=0;
function loop(t){
  const dt=Math.min(.05,(t-last)/1000);last=t;time+=dt;
  if(FS.state==='casting'){FS.t+=dt;if(FS.t>=.7){FS.state='waiting';FS.t=0;FS.biteAt=rnd(2.5,6.5)*stats().bite;setStatus('Waiting for a bite… tap the bobber to reel in early.');refreshCast()}}
  else if(FS.state==='waiting'){FS.t+=dt;if(FS.t>=FS.biteAt){FS.catch=selectCatch();FS.state='bite';FS.t=0;sfx.bite();setStatus('Something is biting! Tap HOOK now!');refreshCast()}}
  else if(FS.state==='bite'){FS.t+=dt;if(FS.t>1.4){FS.state='idle';setStatus('Too slow. It swam off with nothing lost. Cast again.');sfx.lose();refreshCast()}}
  else if(FS.state==='reel'){const m=FS.mg;m.tt-=dt;if(m.tt<=0){m.target=rnd(.04,.96);m.tt=rnd(.35,1.3)/m.diff}
    m.fishY+=(m.target-m.fishY)*clamp(dt*m.spd,0,1)+(Math.random()-.5)*.012*m.diff;m.fishY=clamp(m.fishY,.02,.98);
    m.v+=(holding?2.9:-2.4)*dt;m.zy+=m.v*dt;if(m.zy<0){m.zy=0;m.v=Math.max(0,-m.v*.3)}if(m.zy>1-m.zone){m.zy=1-m.zone;m.v=Math.min(0,-m.v*.3)}
    const inz=m.fishY>=m.zy&&m.fishY<=m.zy+m.zone;m.grace-=dt;
    if(inz)m.prog+=.3*dt*(1+stats().power*.04);else if(m.grace<=0)m.prog-=.22*dt*m.decay;
    if(m.prog>=1){FS.mg=null;landFish();refreshCast()}else if(m.prog<=0){const heavy=m.heavy;FS.mg=null;FS.state='idle';sfx.lose();toast(heavy?'💥 Snap! That fish was too heavy for your line. A stronger line helps.':'🌊 The fish slipped the hook.','red');setStatus('It got away. Cast again.');refreshCast();save()}}
  updateScene(dt);draw();
  secAcc+=dt;if(secAcc>=1){secAcc=0;tickSecond()}
  requestAnimationFrame(loop);
}
function tickSecond(){
  if(S.hut.lvl>0&&S.hut.smoke>0){const rate=SMOKE[S.hut.smoke];S.hut.cash=Math.min(rate*240,S.hut.cash+rate/60)}
  if(S.hut.lvl>0&&S.hut.farm>0){S.hut.farmProg+=S.hut.farm/60;while(S.hut.farmProg>=1){S.hut.farmProg--;const opts=['worm'];if(S.hut.farm>=3)opts.push('cricket');if(S.hut.farm>=5)opts.push('minnow');const b=pick(opts);S.bait[b]=(S.bait[b]||0)+1}}
  fillQuests();
  document.querySelectorAll('[data-cd]').forEach(el=>{const t=+el.dataset.cd-now();el.textContent=mmss(t);if(t<=0&&curTab!=='boss')renderTab()});
  const hc=$('#hutCash');if(hc)hc.textContent=money(S.hut.cash);
  if(Math.floor(time)%10===0)save();
}

