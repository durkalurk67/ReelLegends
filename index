  if(!list.length)return{junk:pick(JUNK)};
  const ws=list.map(f=>{const ri=RAR.indexOf(f.r);return RARD[f.r].w*(1+st.luck*ri*.18)*(f.r==='mythic'?st.mythic:1)});
  let r=Math.random()*ws.reduce((a,b)=>a+b,0),f=list[0];for(let i=0;i<list.length;i++){r-=ws[i];if(r<=0){f=list[i];break}}
