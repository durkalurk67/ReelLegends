function addXP(n){
  n=Math.round(n*stats().xp);S.xp+=n;
  while(S.xp>=xpNeed(S.level)){S.xp-=xpNeed(S.level);S.level++;S.sp++;sfx.lvl();
    toast(`⭐ Level ${S.level}! You earned a skill point.`,'gold');
    AREAS.forEach(a=>{if(a.lvl===S.level&&S.boat.tier>=a.boat)toast(`🗺️ ${a.name} is now open.`,'gold')});
  }
}
