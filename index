/* ============ derived stats ============ */
const rodCombo=()=>ROD_COMBOS.find(c=>c.rod===S.rod&&c.line===S.line)||null;
const baitCombo=()=>S.attrSel?BAIT_COMBOS.find(c=>c.bait===S.baitSel&&c.attr===S.attrSel)||null:null;
const attrActive=id=>S.attrSel===id&&(S.attrs[id]||0)>0;
function aquaLuck(){return S.aqua.reduce((t,it)=>{const f=FISHM[it.id];return t+(RAR.indexOf(f.r)+1)*.03*(it.v==='h'?4:it.v==='s'?2:1)},0)}
function stats(){
  const rod=RODM[S.rod],line=LINEM[S.line],rc=rodCombo(),bc=baitCombo(),pet=S.pet?PETS[S.pet].fx:{};
  const fx=k=>((rc&&rc.fx[k])||0)+((bc&&bc.fx[k])||0)+(pet[k]||0);
  const luck=rod.luck+S.skills.luck*.08+aquaLuck()+(attrActive('clover')?.35:0)+(attrActive('moon')?.2:0)+fx('luck');
  const shiny=S.skills.eye*.12+(attrActive('glitter')?1:0)+fx('shiny');
  const bite=clamp(1-S.skills.pat*.06-(attrActive('oil')?.35:0)-fx('bite'),.2,1);
  const power=rod.power+fx('power');
  return{luck,shiny,bite,power,lineMax:line.max,sell:1+S.skills.hag*.04+(pet.sell||0),xp:1+(pet.xp||0),
    zone:clamp(.17+power*.025+S.skills.str*.012,.17,.46),mythic:(bc&&bc.fx.mythic)||1}
}
const bagMax=()=>20+S.hut.storage*15+S.boat.hold*10;
const xpNeed=l=>Math.floor(60*Math.pow(l,1.6));
const areaOpen=a=>S.level>=a.lvl&&S.boat.tier>=a.boat;
function fishValue(it){const f=FISHM[it.id];const t=(it.w-f.wMin)/Math.max(.001,f.wMax-f.wMin);return Math.max(1,Math.round(f.price*(.75+.6*t)*(it.v==='h'?15:it.v==='s'?4:1)*stats().sell))}
function reqOk(f){if(!f.req)return true;if(f.req.combo){const c=rodCombo();if(!c||c.id!==f.req.combo)return false}if(f.req.attr&&!attrActive(f.req.attr))return false;return true}

