<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Reel Legends</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎣</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gluten:wght@500;700;800&family=Figtree:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{
  --deep:#0b2531; --lake:#123a4b; --lake2:#1a4b5e; --edge:#2b6276;
  --foam:#eef6f1; --mist:#a9c3c8; --bobber:#ef3b36; --bobber-dk:#b4211d;
  --gold:#ffcc4d; --kelp:#57c48a; --line:rgba(238,246,241,.14);
  --display:'Gluten','Trebuchet MS',cursive; --body:'Figtree',system-ui,-apple-system,Segoe UI,sans-serif;
  --r-sm:8px; --r-md:14px;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{margin:0;background:var(--deep);color:var(--foam);font-family:var(--body);font-size:15px;line-height:1.45}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible,[tabindex]:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.hidden{display:none!important}

/* top bar */
.top{display:flex;align-items:center;gap:16px;padding:10px 16px;background:var(--deep);border-bottom:1px solid var(--line);flex-wrap:wrap}
.brand{font-family:var(--display);font-weight:800;font-size:26px;letter-spacing:.5px;line-height:1;color:var(--foam);display:flex;align-items:center;gap:8px}
.brand .dot{width:16px;height:16px;border-radius:50%;background:linear-gradient(var(--bobber) 50%,#fff 50%);box-shadow:0 0 0 2px var(--deep),0 0 0 3px var(--foam)}
.hud{display:flex;gap:14px;align-items:center;margin-left:auto;flex-wrap:wrap}
.coins{font-family:var(--display);font-weight:700;font-size:20px;color:var(--gold)}
.lvl{display:flex;align-items:center;gap:8px;font-weight:600}
.xpbar{width:120px;height:8px;border-radius:99px;background:var(--lake);overflow:hidden}
.xpbar i{display:block;height:100%;background:var(--kelp);width:0;transition:width .3s}
.bagc{color:var(--mist);font-weight:600}
.iconbtn{background:var(--lake);border:1px solid var(--line);border-radius:var(--r-sm);padding:6px 10px}

/* layout */
.wrap{display:grid;grid-template-columns:1fr;gap:0}
@media(min-width:1100px){.wrap{grid-template-columns:minmax(0,1fr) 440px;height:calc(100vh - 58px)}.panel{height:100%;overflow:hidden;display:flex;flex-direction:column}.tab-body{flex:1;overflow:auto}}
.areas{display:flex;gap:6px;padding:10px 12px;overflow-x:auto;background:var(--deep)}
.area{flex:0 0 auto;border:1px solid var(--line);background:var(--lake);border-radius:99px;padding:6px 14px;font-weight:600;white-space:nowrap}
.area[aria-pressed="true"]{background:var(--foam);color:var(--deep);border-color:var(--foam)}
.area.locked{opacity:.55}
.area small{font-weight:400;opacity:.8;margin-left:6px}
.stage{position:relative;margin:0 12px 12px;border-radius:var(--r-md);overflow:hidden;background:#000;touch-action:none;user-select:none;-webkit-user-select:none}
#cv{display:block;width:100%;max-width:100%}
.wrap>*{min-width:0}
.status{position:absolute;left:14px;top:12px;max-width:60%;background:rgba(8,26,35,.78);padding:8px 12px;border-radius:var(--r-sm);font-weight:600;font-size:14px;pointer-events:none}
.loadout{position:absolute;left:14px;bottom:12px;display:flex;gap:6px;flex-wrap:wrap;max-width:62%;pointer-events:none}
.chip{background:rgba(8,26,35,.78);border-radius:99px;padding:4px 10px;font-size:12.5px;font-weight:600;white-space:nowrap}
.chip.combo{background:var(--gold);color:var(--deep)}

/* the bobber */
.cast{position:absolute;right:18px;bottom:16px;width:104px;height:104px;border-radius:50%;border:0;
  background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.55),transparent 32%),linear-gradient(var(--bobber) 0 52%,#fbfbf7 52% 100%);
  box-shadow:inset 0 -6px 0 rgba(0,0,0,.12),0 0 0 4px var(--deep),0 8px 0 4px rgba(0,0,0,.25);
  font-family:var(--display);font-weight:800;font-size:21px;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding-top:20px;text-shadow:0 2px 0 var(--bobber-dk);transition:transform .08s}
.cast::before{content:"";position:absolute;top:-16px;left:50%;width:6px;height:20px;margin-left:-3px;border-radius:3px;background:var(--bobber-dk)}
.cast:active,.cast.held{transform:translateY(4px) scale(.97)}
.cast.bite{animation:dunk .35s ease-in-out infinite alternate}
.cast[disabled]{filter:grayscale(.6);opacity:.7}
@keyframes dunk{to{transform:translateY(8px) rotate(-6deg)}}
.hint{position:absolute;right:18px;bottom:128px;font-size:12px;color:var(--foam);background:rgba(8,26,35,.78);padding:4px 8px;border-radius:6px;pointer-events:none}

/* panel */
.panel{background:var(--lake);border-left:1px solid var(--line)}
.tabs{display:flex;gap:2px;overflow-x:auto;padding:8px 8px 0;background:var(--deep);border-bottom:1px solid var(--line)}
.tab{flex:0 0 auto;border:0;background:transparent;padding:8px 12px;border-radius:var(--r-sm) var(--r-sm) 0 0;font-weight:600;color:var(--mist);position:relative}
.tab[aria-selected="true"]{background:var(--lake);color:var(--foam)}
.tab .badge{position:absolute;top:4px;right:4px;width:8px;height:8px;border-radius:50%;background:var(--bobber)}
.tab-body{padding:14px 16px 40px}
h2{font-family:var(--display);font-weight:700;font-size:24px;margin:4px 0 4px;line-height:1.1}
h3{font-family:var(--display);font-weight:700;font-size:18px;margin:18px 0 8px}
.sub{color:var(--mist);margin:0 0 10px;font-size:14px}
.row{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}
.row:last-child{border-bottom:0}
.row .grow{flex:1;min-width:0}
.row .name{font-weight:800}
.row .meta{font-size:13px;color:var(--mist)}
.btn{border:0;border-radius:var(--r-sm);padding:7px 12px;font-weight:800;background:var(--foam);color:var(--deep);white-space:nowrap}
.btn.red{background:var(--bobber);color:#fff}
.btn.ghost{background:transparent;border:1px solid var(--line);color:var(--foam)}
.btn.gold{background:var(--gold);color:var(--deep)}
.btn[disabled]{opacity:.4;cursor:not-allowed}
.tag{display:inline-block;font-size:11.5px;font-weight:800;padding:1px 7px;border-radius:99px;background:var(--lake2);margin-left:4px;vertical-align:1px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(122px,1fr));gap:8px}
.card{background:var(--lake2);border-radius:var(--r-sm);padding:8px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:2px;position:relative;border:1px solid transparent}
.card .fn{font-weight:800;font-size:13px;line-height:1.2}
.card .fm{font-size:12px;color:var(--mist)}
.card .acts{display:flex;gap:4px;margin-top:6px;flex-wrap:wrap;justify-content:center}
.card .acts .btn{padding:4px 8px;font-size:12px}
.card.sel{border-color:var(--gold)}
.star{position:absolute;top:4px;left:6px;background:none;border:0;font-size:15px;padding:0;color:var(--mist)}
.star.on{color:var(--gold)}
.rar-common{color:#b9c4cc}.rar-uncommon{color:#6be39a}.rar-rare{color:#5cc8ff}.rar-epic{color:#cf9bff}.rar-legendary{color:#ffcc4d}.rar-mythic{color:#ff8ad1}
.statgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:8px 0 4px}
.stat{background:var(--lake2);border-radius:var(--r-sm);padding:6px 8px}
.stat b{display:block;font-family:var(--display);font-size:18px;font-weight:700}
.stat span{font-size:12px;color:var(--mist)}
.pips{display:inline-flex;gap:3px;vertical-align:middle}
.pips i{width:9px;height:9px;border-radius:2px;background:var(--deep)}
.pips i.on{background:var(--kelp)}
.swatch{width:34px;height:34px;border-radius:50%;border:3px solid transparent;padding:0}
.swatch[aria-pressed="true"]{border-color:var(--gold)}
.swatches{display:flex;flex-wrap:wrap;gap:8px}
.bigemoji{font-size:30px;line-height:1.1}
.sil{opacity:.9}
.toolbar{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0 10px}

/* fish svg */
svg.fish{overflow:visible}
svg.fish.holo{animation:holo 3s linear infinite}
@keyframes holo{to{filter:hue-rotate(360deg)}}
svg.fish .spk{animation:twinkle 1.4s ease-in-out infinite alternate}
@keyframes twinkle{from{opacity:.35}to{opacity:1}}

/* modal */
.modal{position:fixed;inset:0;background:rgba(4,14,20,.72);display:flex;align-items:center;justify-content:center;z-index:50;padding:16px}
.modal-card{background:var(--lake);border:1px solid var(--edge);border-radius:var(--r-md);width:min(440px,100%);padding:20px;max-height:92vh;overflow:auto}
.catch{text-align:center}
.catch .fishbig{margin:6px auto 0;display:block}
.catch .title{font-family:var(--display);font-size:30px;font-weight:800;line-height:1.05;margin:6px 0 2px}
.vbadge{display:inline-block;font-weight:800;font-size:12px;padding:2px 9px;border-radius:99px;margin:2px}
.vbadge.s{background:var(--gold);color:var(--deep)}
.vbadge.h{background:linear-gradient(90deg,#ff6ad5,#94d0ff,#8affc1,#fff58a);color:var(--deep)}
.vbadge.new{background:var(--kelp);color:var(--deep)}
.modal .acts{display:flex;gap:8px;justify-content:center;margin-top:14px;flex-wrap:wrap}

/* boss */
.boss{text-align:center}
.boss .face{font-size:84px;line-height:1;margin:6px 0;display:inline-block;transition:transform .08s}
.boss .face.hit{transform:scale(.88) rotate(-6deg);filter:brightness(1.6)}
.bar{height:14px;border-radius:99px;background:var(--deep);overflow:hidden;margin:4px 0 10px}
.bar i{display:block;height:100%;transition:width .15s}
.bar.hp i{background:var(--bobber)}
.bar.me i{background:var(--kelp)}
.meter{position:relative;height:30px;border-radius:var(--r-sm);background:var(--deep);margin:12px 0;overflow:hidden}
.meter .y{position:absolute;top:0;bottom:0;left:35%;width:30%;background:rgba(255,204,77,.35)}
.meter .g{position:absolute;top:0;bottom:0;left:44%;width:12%;background:var(--kelp)}
.meter .needle{position:absolute;top:-2px;bottom:-2px;width:4px;margin-left:-2px;background:#fff;border-radius:2px;box-shadow:0 0 6px #fff}
.blog{min-height:22px;font-weight:600;color:var(--mist)}
.lbl{display:flex;justify-content:space-between;font-size:13px;font-weight:600}

/* toasts */
#toasts{position:fixed;left:50%;top:calc(env(safe-area-inset-top,0px) + 12px);transform:translateX(-50%);display:flex;flex-direction:column;gap:6px;z-index:60;pointer-events:none;width:min(420px,92vw)}
.toast{background:var(--foam);color:var(--deep);padding:8px 12px;border-radius:var(--r-sm);font-weight:600;box-shadow:0 6px 20px rgba(0,0,0,.35);display:flex;align-items:center;gap:8px;animation:tin .25s ease-out}
.toast.gold{background:var(--gold)}
.toast.red{background:var(--bobber);color:#fff}
@keyframes tin{from{transform:translateY(-8px);opacity:0}}
@media(max-width:600px){.brand{font-size:21px}.cast{width:86px;height:86px;font-size:18px;padding-top:15px}.hint{bottom:110px}.status{max-width:75%;font-size:13px}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<header class="top">
  <div class="brand"><span class="dot" aria-hidden="true"></span>Reel Legends</div>
  <div class="hud">
    <span class="coins" id="hCoins">$0</span>
    <span class="lvl">Lv <span id="hLvl">1</span><span class="xpbar" title="Experience"><i id="hXp"></i></span></span>
    <span class="bagc" id="hBag">Bag 0/20</span>
    <button class="iconbtn" id="soundBtn" aria-label="Toggle sound">🔊</button>
  </div>
</header>
<div class="wrap">
  <div>
    <nav class="areas" id="areas" aria-label="Fishing spots"></nav>
    <div class="stage" id="stage">
      <canvas id="cv"></canvas>
      <div class="status" id="status">Pick your spot, then tap the bobber to cast.</div>
      <div class="loadout" id="loadout"></div>
      <div class="hint" id="hint">Space or hold to reel</div>
      <button class="cast" id="castBtn">Cast</button>
    </div>
  </div>
  <section class="panel">
    <div class="tabs" id="tabs" role="tablist"></div>
    <div class="tab-body" id="tabBody"></div>
  </section>
</div>
<div class="modal hidden" id="modal"><div class="modal-card" id="modalCard" role="dialog" aria-modal="true"></div></div>
<div id="toasts" aria-live="polite"></div>

<script>
'use strict';
/* ============ helpers ============ */
const $=s=>document.querySelector(s);
const rnd=(a,b)=>a+Math.random()*(b-a);
const rint=(a,b)=>Math.floor(rnd(a,b+1));
const pick=a=>a[Math.floor(Math.random()*a.length)];
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const fmt=n=>{n=Math.floor(n);return n>=1e6?(Math.floor(n/1e4)/100).toFixed(2)+'M':n>=1e5?Math.floor(n/1e3)+'k':n.toLocaleString()};
const money=n=>'$'+fmt(n);
const uid=()=>Math.random().toString(36).slice(2,10);
const now=()=>Date.now();
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function mix(a,b,t){const p=h=>[1,3,5].map(i=>parseInt(h.slice(i,i+2),16));const x=p(a),y=p(b);return '#'+x.map((v,i)=>Math.round(v+(y[i]-v)*t).toString(16).padStart(2,'0')).join('')}
const mmss=ms=>{ms=Math.max(0,ms);const s=Math.ceil(ms/1000);return Math.floor(s/60)+':'+String(s%60).padStart(2,'0')};

/* ============ game data ============ */
const RAR=['common','uncommon','rare','epic','legendary','mythic'];
const RARD={
  common:{n:'Common',w:600,diff:.55,xp:8},
  uncommon:{n:'Uncommon',w:250,diff:.75,xp:15},
  rare:{n:'Rare',w:100,diff:.95,xp:30},
  epic:{n:'Epic',w:38,diff:1.2,xp:60},
  legendary:{n:'Legendary',w:8,diff:1.45,xp:150},
  mythic:{n:'Mythic',w:1,diff:1.75,xp:400}
};
const AREAS=[
  {id:'pond',name:'Willow Pond',lvl:1,boat:0,sky:['#ffd7a6','#f7a98c'],sun:'#fff3c4',water:['#3f9a8e','#174c56'],kind:'pond',hill:'#5d8a4c',hill2:'#3e6a39'},
  {id:'river',name:'Misty River',lvl:3,boat:0,sky:['#b9d3dc','#e3ece6'],sun:'#ffffff',water:['#4c8ca0','#1d4a5c'],kind:'river',hill:'#7d98a4',hill2:'#4f6b78'},
  {id:'reef',name:'Coral Reef',lvl:6,boat:1,sky:['#6fd0f0','#c9f3ff'],sun:'#fff8d0',water:['#22c1c3','#0b6d8f'],kind:'reef',hill:'#e9d39b',hill2:'#3f9a5a'},
  {id:'fjord',name:'Frozen Fjord',lvl:10,boat:2,sky:['#2c3e6b','#9fb7d6'],sun:'#e7f0ff',water:['#5b8fb0','#14324a'],kind:'fjord',hill:'#d9e6f2',hill2:'#6d86a3'},
  {id:'lava',name:'Ember Lagoon',lvl:15,boat:3,sky:['#2a0f14','#a33a1c'],sun:'#ff9a3c',water:['#5a2a24','#1f0c0c'],kind:'lava',hill:'#2b1716',hill2:'#160b0b'},
  {id:'abyss',name:'Abyssal Trench',lvl:20,boat:4,sky:['#02060f','#0a1d33'],sun:'#9fe8ff',water:['#082238','#010509'],kind:'abyss',hill:'#0b1424',hill2:'#060b14'}
];
const AREA=Object.fromEntries(AREAS.map((a,i)=>[a.id,Object.assign(a,{idx:i})]));

function F(id,name,area,r,baits,price,wMin,wMax,body,fin,shape,req){return {id,name,area,r,baits,price,wMin,wMax,col:[body,fin],shape,req:req||null}}
const FISH=[
  F('bluegill','Bluegill','pond','common',['worm','cricket'],6,.3,1.5,'#5b8fb9','#f2a65a','round'),
  F('perch','Yellow Perch','pond','common',['worm','minnow'],7,.4,2,'#d9c045','#3d5a3a','std'),
  F('carp','Golden Carp','pond','uncommon',['worm','cricket'],18,2,12,'#f0a830','#c46a1b','std'),
  F('bass','Largemouth Bass','pond','rare',['minnow','cricket'],45,2,10,'#5d7d3a','#2e4220','std'),
  F('catfish','Whiskered Catfish','pond','epic',['minnow','worm'],130,8,40,'#6b5b4b','#3a3028','long'),
  F('lilykoi','Lily Koi','pond','legendary',['cricket'],600,3,14,'#fff4e6','#ff5a3c','std',{attr:'glitter'}),
  F('celestial','Celestial Koi','pond','mythic',['worm','cricket','minnow'],8000,5,20,'#1b1f4b','#ffd86b','std',{combo:'constellation'}),

  F('chub','Creek Chub','river','common',['worm','cricket'],9,.5,3,'#a3a7a0','#6a6e66','std'),
  F('rtrout','Brook Trout','river','common',['worm','minnow'],11,1,5,'#8a9a6b','#c75d4f','long'),
  F('rainbow','Rainbow Trout','river','uncommon',['minnow','cricket'],28,2,9,'#9fc0a8','#e86a8a','long'),
  F('pike','Northern Pike','river','rare',['minnow'],70,5,30,'#5e7a3c','#c9b458','long'),
  F('sturgeon','Lake Sturgeon','river','epic',['worm','minnow'],220,40,180,'#6e6a62','#3c3a35','shark'),
  F('ghosttrout','Ghost Trout','river','epic',['cricket','minnow'],300,3,12,'#e4ecf2','#9fb3c8','long',{combo:'riverwhisper'}),
  F('moonsalmon','Moonlit Salmon','river','legendary',['minnow','cricket'],900,8,35,'#c9d2f5','#6b6fd6','long',{attr:'moon'}),

  F('clown','Clownfish','reef','common',['shrimp'],14,.2,.8,'#ff7a1a','#ffffff','round'),
  F('tang','Blue Tang','reef','common',['shrimp','minnow'],16,.5,2,'#2f6fdc','#f5d020','round'),
  F('parrot','Parrotfish','reef','uncommon',['shrimp','squid'],40,3,15,'#3fd0a8','#e85da8','std'),
  F('lion','Lionfish','reef','rare',['shrimp','minnow'],95,1,3,'#e8604a','#f6e7d8','round'),
  F('pipefish','Neon Pipefish','reef','rare',['shrimp'],180,.2,1,'#39ff9e','#ff3df0','eel',{combo:'reefdancer'}),
  F('hammer','Hammerhead','reef','epic',['squid'],320,80,300,'#7b8a99','#4b5866','shark'),
  F('manta','Rainbow Manta','reef','legendary',['shrimp','squid'],1400,200,900,'#33415c','#7fe0ff','ray'),

  F('char','Arctic Char','fjord','common',['minnow','shrimp'],22,1,8,'#c45b4a','#e9e2d0','std'),
  F('icecod','Ice Cod','fjord','common',['shrimp','squid'],20,2,12,'#b9c7cf','#7d8f99','std'),
  F('halibut','Glacier Halibut','fjord','uncommon',['squid','minnow'],60,20,120,'#8c8172','#d9d0c0','ray'),
  F('crystaleel','Crystal Eel','fjord','rare',['shrimp'],160,3,15,'#bfe9ff','#6fc3ff','eel'),
  F('wolffish','Frostfang Wolffish','fjord','epic',['squid'],420,15,60,'#5a6f86','#e8f6ff','long'),
  F('aurora','Aurora Whitefish','fjord','legendary',['minnow','shrimp'],2200,5,25,'#e9fff7','#7cffc4','std'),
  F('permapike','Permafrost Pike','fjord','legendary',['squid','minnow'],3000,30,140,'#dff3ff','#3aa0ff','long',{combo:'frostbite'}),

  F('ember','Ember Minnow','lava','common',['magma','glow'],35,.3,1.2,'#ff7b29','#ffd23f','std'),
  F('ash','Ash Guppy','lava','common',['magma'],32,.2,1,'#5a5452','#ff6a3d','round'),
  F('cinder','Cinder Snapper','lava','uncommon',['magma','glow'],90,4,18,'#d4442b','#2a1a18','std'),
  F('obsidian','Obsidian Gar','lava','rare',['glow'],240,20,90,'#2a2433','#a855f7','long'),
  F('magmaray','Magma Ray','lava','epic',['magma'],650,100,400,'#3a1d18','#ff5f1f','ray'),
  F('phoenix','Phoenix Koi','lava','legendary',['magma','glow'],3800,10,40,'#ff9a3c','#ffe08a','std'),
  F('solarbetta','Solar Flare Betta','lava','mythic',['glow'],15000,2,6,'#ff3d00','#ffe600','round',{combo:'inferno'}),

  F('lantern','Lanternfish','abyss','common',['glow','squid'],60,.2,1,'#1e3350','#5ef2ff','std'),
  F('gulper','Gulper Eel','abyss','common',['squid'],65,2,8,'#2a2638','#ff4fa3','eel'),
